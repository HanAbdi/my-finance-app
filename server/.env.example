# Port server
PORT=5000

# Connect to Supabase via connection pooling
DATABASE_URL="postgresql://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-ID]:[YOUR-PASSWORD]@[REGION].pooler.supabase.com:5432/postgres"